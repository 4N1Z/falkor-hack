# Copy this file to `.env` and fill in real values.
# Validated by src/env.ts at startup (next.config.mjs imports it).

# --- Database / Supabase ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
AUTH_DRIZZLE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DB_NAME=postgres
PW=postgres
SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Auth.js (generate AUTH_SECRET with `npx auth secret`) ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Third-party APIs ---
OPENAI_API_KEY=
STRAPI_API_KEY=
ZOTERO_API_ENDPOINT=https://api.zotero.org
ZOTERO_CLIENT_KEY=
ZOTERO_CLIENT_SECRET=

# --- Research graph (FalkorDB) + relevance scoring (JEV) ---
FALKORDB_URL=falkor://localhost:6379
# Optional: without it, agents fall back to embeddings + gpt-4o-mini
TYPESAFE_API_KEY=
# Optional, but strongly recommended (shared anonymous rate limit is ~1 req/s)
SEMANTIC_SCHOLAR_API_KEY=

# --- Stripe (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- App URLs ---
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ZOTERO_CALLBACK_URL=http://localhost:3000/api/zotero/callback

# --- Misc ---
REACT_EDITOR=code
SHOW_OUTRAGEOUS_CONTENT=false
