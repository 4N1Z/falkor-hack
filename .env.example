# Copy this file to `.env` and fill in real values.
# Validated by src/env.ts at startup (next.config.mjs imports it).

# --- Database / Supabase ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
AUTH_DRIZZLE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DB_NAME=postgres
PW=postgres
SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Auth.js (generate AUTH_SECRET with `npx auth secret`) ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Third-party APIs ---
# Text generation (agents, chat, editor AI): DeepSeek V4. Optional DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# Reasoning mode is off (it slows short grounded prompts 4–6× and eats max_tokens); set to 1 to enable
DEEPSEEK_THINKING=0
# Embeddings (vector search over papers, passages, notes): Cohere embed-english-v3.0
COHERE_API_KEY=
STRAPI_API_KEY=
ZOTERO_API_ENDPOINT=https://api.zotero.org
ZOTERO_CLIENT_KEY=
ZOTERO_CLIENT_SECRET=

# --- Research graph (FalkorDB) + typed relevance judgements ---
FALKORDB_URL=falkor://localhost:6380

# OpenAlex meters keyless traffic against a shared daily budget; a free key (openalex.org) lifts it.
# Without it the Librarian and Adam's Searcher degrade to rate-limit errors once the budget is spent.
# Required for Adam sweeps: keyless OpenAlex is ~100 requests a day, a sweep needs ~250. Set it for every worker.
OPENALEX_API_KEY=
# Longest a single Adam job may run before its worker abandons it (minutes)
ADAM_JOB_TIMEOUT_MIN=60
# Per-query timeout for Adam's Cypher calls (ms). The module default of 1 s is
# too low for the Analyst's community detection on a small host.
ADAM_QUERY_TIMEOUT_MS=120000
# Sent to OpenAlex on every request; a real address puts us in the polite pool
OPENALEX_MAILTO=
# Legacy, still interpolated by docker-compose
ANTROPIC_API_KEY=
# Optional: a larger DeepSeek model for Adam's heavy agents (extractor, methods hunter, writer, falsifier)
DEEPSEEK_HEAVY_MODEL=
# Optional: typed relevance judgements; without it every judgement falls back to a small DeepSeek call
TYPESAFE_API_KEY=
# Optional: enables the read-only MCP server at /api/mcp (Bearer token, 16+ characters)
MCP_TOKEN=

# --- Stripe (optional) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- App URLs ---
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ZOTERO_CALLBACK_URL=http://localhost:3000/api/zotero/callback

# --- Misc ---
REACT_EDITOR=code
SHOW_OUTRAGEOUS_CONTENT=false
